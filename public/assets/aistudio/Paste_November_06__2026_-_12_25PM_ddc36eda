import 'dart:convert';
import 'package:flutter/foundation.dart';
import 'package:shared_preferences/shared_preferences.dart';
import '../models/notice_model.dart';

class NoticeProvider with ChangeNotifier {
  List<NoticeModel> _notices = [];
  String _selectedDepartment = 'All';
  String _searchQuery = '';
  bool _isLoading = false;

  List<NoticeModel> get notices {
    return _notices.where((n) {
      final matchesDept = _selectedDepartment == 'All' || n.department == _selectedDepartment;
      final matchesQuery = _searchQuery.isEmpty ||
          n.title.toLowerCase().contains(_searchQuery.toLowerCase()) ||
          n.content.toLowerCase().contains(_searchQuery.toLowerCase());
      return matchesDept && matchesQuery;
    }).toList();
  }

  String get selectedDepartment => _selectedDepartment;
  String get searchQuery => _searchQuery;
  bool get isLoading => _isLoading;

  Future<void> init() async {
    _isLoading = true;
    notifyListeners();

    final prefs = await SharedPreferences.getInstance();
    final savedData = prefs.getString('saved_notices');

    if (savedData != null) {
      final List decoded = jsonDecode(savedData);
      _notices = decoded.map((item) => NoticeModel.fromJson(item)).toList();
    } else {
      _loadDefaultNotices();
      await _persist();
    }

    _isLoading = false;
    notifyListeners();
  }

  void setDepartment(String dept) {
    _selectedDepartment = dept;
    notifyListeners();
  }

  void setSearchQuery(String query) {
    _searchQuery = query;
    notifyListeners();
  }

  Future<void> addNotice(NoticeModel notice) async {
    _notices.insert(0, notice);
    notifyListeners();
    await _persist();
  }

  Future<void> toggleBookmark(String id) async {
    final index = _notices.indexWhere((n) => n.id == id);
    if (index != -1) {
      _notices[index].isBookmarked = !_notices[index].isBookmarked;
      notifyListeners();
      await _persist();
    }
  }

  Future<void> incrementViews(String id) async {
    final index = _notices.indexWhere((n) => n.id == id);
    if (index != -1) {
      _notices[index].views += 1;
      notifyListeners();
      await _persist();
    }
  }

  Future<void> _persist() async {
    final prefs = await SharedPreferences.getInstance();
    final encoded = jsonEncode(_notices.map((n) => n.toJson()).toList());
    await prefs.setString('saved_notices', encoded);
  }

  void _loadDefaultNotices() {
    _notices = [
      NoticeModel(
        id: 'not-01',
        title: 'B.Tech III Year II Sem Regular Examinations Schedule (Nov 2026)',
        department: 'Exam Cell',
        priority: 'Urgent',
        date: 'Today, 09:30 AM',
        author: 'Dr. M. Venkata Ramana',
        authorRole: 'Controller of Examinations',
        content: 'Semester End Examinations for B.Tech III-II commence from Nov 24, 2026. Clear departmental dues to obtain hall tickets.',
        attachmentName: 'Exam_Schedule_Nov2026.pdf',
        attachmentSize: '1.4 MB',
        views: 342,
      ),
      NoticeModel(
        id: 'not-02',
        title: 'TCS & Infosys Campus Recruitment Drive: Technical Shortlist',
        department: 'Placement Cell',
        priority: 'Placement',
        date: 'Yesterday, 04:15 PM',
        author: 'Prof. K. Suresh Babu',
        authorRole: 'Head - Training & Placements',
        content: 'Shortlisted candidates must report to Central Seminar Hall on Monday with 3 copies of updated resume.',
        attachmentName: 'Shortlist_Candidates.xlsx',
        attachmentSize: '480 KB',
        views: 890,
      ),
    ];
