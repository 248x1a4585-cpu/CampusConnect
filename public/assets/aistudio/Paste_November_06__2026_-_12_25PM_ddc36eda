void main() async {
  WidgetsFlutterBinding.ensureInitialized();
  runApp(const CampusConnectApp());
}

class CampusConnectApp extends StatelessWidget {
  const CampusConnectApp({super.key});

  @override
  Widget build(BuildContext context) {
    // MultiProvider architecture for global reactive state
    return MultiProvider(
      providers: [
        ChangeNotifierProvider(create: (_) => NoticeProvider()..init()),
        ChangeNotifierProvider(create: (_) => EventProvider()..init()),
        ChangeNotifierProvider(create: (_) => MaterialProvider()..init()),
        ChangeNotifierProvider(create: (_) => StudentProvider()..init()),
      ],
      child: Consumer<StudentProvider>(
        builder: (context, studentProvider, child) {
          return MaterialApp(
            title: 'CampusConnect',
            debugShowCheckedModeBanner: false,
            theme: AppTheme.lightTheme,
            darkTheme: AppTheme.darkTheme,
            themeMode: studentProvider.isDarkMode ? ThemeMode.dark : ThemeMode.light,
            home: const MainNavigationShell(),
            routes: {
              '/dashboard': (context) => const DashboardScreen(),
              '/notices': (context) => const NoticeListScreen(),
              '/add-notice': (context) => const AddNoticeScreen(),
              '/events': (context) => const EventsScreen(),
              '/materials': (context) => const MaterialsScreen(),
              '/profile': (context) => const ProfileScreen(),
              '/venues': (context) => const CampusVenuesScreen(),
              '/student-management': (context) => const StudentManagementScreen(),
            },
          );
        },
      ),
    );
  }
}

class MainNavigationShell extends StatefulWidget {
  const MainNavigationShell({super.key});

  @override
  State<MainNavigationShell> createState() => _MainNavigationShellState();
}

class _MainNavigationShellState extends State<MainNavigationShell> {
  int _selectedIndex = 0;

  @override
  Widget build(BuildContext context) {
    final studentProvider = Provider.of<StudentProvider>(context);
    final isFaculty = studentProvider.currentUserRole == 'faculty';

    final screens = isFaculty
        ? const [
            DashboardScreen(),
            NoticeListScreen(),
            StudentManagementScreen(),
            CampusVenuesScreen(),
            ProfileScreen(),
          ]
        : const [
            DashboardScreen(),
            NoticeListScreen(),
            EventsScreen(),
            CampusVenuesScreen(),
            ProfileScreen(),
          ];

    final destinations = isFaculty
        ? const [
            NavigationDestination(icon: Icon(Icons.dashboard_outlined), selectedIcon: Icon(Icons.dashboard), label: 'Home'),
            NavigationDestination(icon: Icon(Icons.notifications_none), selectedIcon: Icon(Icons.notifications), label: 'Notices'),
            NavigationDestination(icon: Icon(Icons.people_outline), selectedIcon: Icon(Icons.people), label: 'Students'),
            NavigationDestination(icon: Icon(Icons.apartment_outlined), selectedIcon: Icon(Icons.apartment), label: 'Rooms & Labs'),
            NavigationDestination(icon: Icon(Icons.person_outline), selectedIcon: Icon(Icons.person), label: 'Faculty'),
          ]
        : const [
            NavigationDestination(icon: Icon(Icons.dashboard_outlined), selectedIcon: Icon(Icons.dashboard), label: 'Home'),
            NavigationDestination(icon: Icon(Icons.notifications_none), selectedIcon: Icon(Icons.notifications), label: 'Notices'),
            NavigationDestination(icon: Icon(Icons.calendar_month_outlined), selectedIcon: Icon(Icons.calendar_month), label: 'Events'),
            NavigationDestination(icon: Icon(Icons.apartment_outlined), selectedIcon: Icon(Icons.apartment), label: 'Rooms & Labs'),
            NavigationDestination(icon: Icon(Icons.person_outline), selectedIcon: Icon(Icons.person), label: 'Profile'),
          ];

    return Scaffold(
      body: IndexedStack(
        index: _selectedIndex,
        children: screens,
      ),
      bottomNavigationBar: NavigationBar(
        selectedIndex: _selectedIndex,
        onDestinationSelected: (index) {
          setState(() {
            _selectedIndex = index;
          });
        },
        destinations: destinations,
      ),
    );
  }
}



